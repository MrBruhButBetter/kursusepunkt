# Copy to .env and adjust. .env is git-ignored; this file is committed.
#
#   cp .env.example .env

# Database
DB_NAME=kursusepunkt
DB_USER=app
DB_PASSWORD=app
DB_PORT=5432

# Application
APP_PORT=8080

# The UI module's development server
CORS_ORIGINS=http://localhost:5173

# Never put a real production secret in this file or in .env.
